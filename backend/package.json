  "scripts": {
    "dev": "nodemon",
    "build": "tsc --project tsconfig.json",
    "build:clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:prod": "npm run build:clean && tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs --lines 100",
    "verify": "cross-env DOTENV_CONFIG_PATH=.env tsx -r dotenv/config scripts/verify-connections.ts",
    "seed:admin": "cross-env DOTENV_CONFIG_PATH=.env tsx -r dotenv/config scripts/seed-superadmin.ts",
    "test": "cross-env NODE_ENV=test tsx -r dotenv/config node_modules/vitest/vitest.mjs run"
  },
